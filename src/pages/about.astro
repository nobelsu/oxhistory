---
import BaseLayout from '../layouts/BaseLayout.astro';
import Engraving from '../components/Engraving.astro';
import site from '../data/site.json';
---

<BaseLayout title="About" description={site.about}>
  <section class="wrap page-head">
    <p class="eyebrow reveal" data-d="1">About the Society</p>
    <h1 class="reveal" data-d="2">Who we are</h1>
  </section>

  <section class="wrap section about-body">
    <div class="about-intro">
      <p class="lede reveal" data-d="3">{site.about}</p>
      <div class="about-eng reveal" data-d="4"><Engraving slug="clarendon" /></div>
    </div>

    <div class="cols">
      <div class="col">
        <h3>Academic events</h3>
        <p>Talks by leading historians, panel discussions, and conversations that take you beyond the syllabus — for undergraduates, postgraduates, and anyone curious about the past.</p>
      </div>
      <div class="col">
        <h3>Social events</h3>
        <p>Inter-college pub quizzes, bar crawls, and dinners. A relaxed way to meet history students from every college across the University.</p>
      </div>
      <div class="col">
        <h3>Welfare events</h3>
        <p>Prelims advice picnics, caffeinated study sessions, and a supportive community to help you through the busier weeks of term.</p>
      </div>
    </div>

    <div class="cta-row">
      <a class="btn btn-primary" href={site.joinFormUrl} target="_blank" rel="noopener">Become a member</a>
      <a class="btn btn-ghost" href="/committee">Meet the committee</a>
    </div>
  </section>
</BaseLayout>

<style>
  .about-body { padding-top: 0; }
  .about-intro { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.75rem, 4vw, 3.5rem); align-items: start; margin-bottom: 2.5rem; }
  .about-intro .lede { margin-bottom: 0; }
  .about-eng { max-width: 520px; }
  @media (max-width: 760px) { .about-intro { grid-template-columns: 1fr; gap: 1.75rem; } .about-eng { max-width: 460px; } }
  .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 4vw, 3rem); margin: 2.75rem 0; }
  .col { padding-top: 1.2rem; border-top: 2px solid var(--royal); }
  .col h3 { margin-bottom: 0.4rem; }
  .col p { margin: 0; color: var(--ink-soft); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem; }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr; } }
</style>
