---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="wrap notfound">
    <p class="eyebrow">Error 404</p>
    <h1>This page has been lost to history.</h1>
    <p class="lede">The page you're looking for doesn't exist or has moved.</p>
    <a class="btn btn-primary" href="/">Return home</a>
  </section>
</BaseLayout>

<style>
  .notfound { padding-block: clamp(4rem, 12vw, 9rem); text-align: center; }
  .notfound .lede { margin: 0 auto 2rem; }
  .notfound .eyebrow { color: var(--gold); }
</style>
