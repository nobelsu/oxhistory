---
import BaseLayout from '../layouts/BaseLayout.astro';
import committee from '../data/committee.json';
import site from '../data/site.json';

// Preferred display order for roles. Members are sorted by this, keeping their
// order within a role. Any role not listed falls to the end, so adding a new
// role in the CMS still works without editing this file.
const roleOrder = [
  'President',
  'Secretary',
  'Treasurer',
  'Welfare Officer',
  'Social Media Manager',
  'Sponsorship and Marketing Director',
  'Academic Events Officer',
  'Social Events Officer',
];
const rank = (r: string) => (roleOrder.indexOf(r) === -1 ? 99 : roleOrder.indexOf(r));
const members = [...committee.members]
  .map((m, i) => ({ m, i }))
  .sort((a, b) => rank(a.m.role) - rank(b.m.role) || a.i - b.i)
  .map((x) => x.m);
---

<BaseLayout title="Committee" description={`The Oxford History Society committee for ${committee.year}.`}>
  <section class="wrap page-head">
    <p class="eyebrow reveal" data-d="1">The Committee · {committee.year}</p>
    <h1 class="reveal" data-d="2">Meet the committee</h1>
    <p class="lede reveal" data-d="3">The people who run the Society — elected each year to organise our academic, social and welfare programme.</p>
  </section>

  <section class="wrap section committee-body">
    <div class="member-grid">
      {members.map((m) => (
        <article class="member">
          {m.photo ? (
            <img class="member-photo" src={m.photo} alt={m.name} loading="lazy" width="320" height="360" />
          ) : (
            <div class="member-photo monogram" aria-hidden="true">{m.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}</div>
          )}
          <div class="member-info">
            <p class="member-role">{m.role}</p>
            <p class="member-name">{m.name}</p>
            <p class="member-college">{m.college}</p>
            <p class="member-subject">{m.subject}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="contact-note">
      <p>Questions for the committee? Contact us on Instagram <a href={`https://instagram.com/${site.instagramHandle}`} target="_blank" rel="noopener">@{site.instagramHandle}</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .committee-body { padding-top: 0; }
  .member-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }
  @media (min-width: 640px) { .member-grid { grid-template-columns: repeat(3, 1fr); gap: 1.3rem; } }
  @media (min-width: 980px) { .member-grid { grid-template-columns: repeat(5, 1fr); gap: 1.4rem; } }
  .member {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--rule-soft);
    border-radius: 3px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }
  .member:hover { border-color: var(--royal); }
  .member-photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center top;
    display: block;
    background: var(--cream);
  }
  .monogram.member-photo {
    display: grid;
    place-items: center;
    background: var(--navy);
    color: var(--cream-soft);
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 600;
  }
  .member-info { padding: 1rem 1.1rem 1.2rem; border-top: 2px solid var(--royal); }
  .member-role {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--royal);
    margin: 0 0 0.4rem;
  }
  .member-name { font-family: var(--font-display); font-size: 1.25rem; color: var(--navy); margin: 0 0 0.15rem; line-height: 1.12; }
  .member-college { margin: 0; font-style: italic; color: var(--ink-soft); font-size: 0.9rem; }
  .member-subject { margin: 0.15rem 0 0; font-size: 0.82rem; color: var(--ink-soft); }

  .contact-note { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--rule-soft); color: var(--ink-soft); }
  .contact-note p { margin: 0; }

  @media (max-width: 520px) {
    .member-grid { gap: 1rem; }
    .member-name { font-size: 1.05rem; }
  }
</style>
