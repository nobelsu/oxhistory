---
import site from '../data/site.json';
const year = 2026;
---

<footer class="site-footer">
  <div class="wrap foot">
    <div class="foot-brand">
      <img src="/crest.png" alt="" width="64" height="64" />
      <p class="foot-name">Oxford University History Society</p>
    </div>

    <nav class="foot-nav" aria-label="Pages">
      <a href="/about">About</a>
      <a href="/events">Events</a>
      <a href="/committee">Committee</a>
    </nav>

    <nav class="foot-nav" aria-label="More pages">
      <a href="/sponsors">Sponsors</a>
      <a href="/contact">Contact us</a>
      <a href="/join">Join</a>
    </nav>

    <nav class="foot-nav" aria-label="Governance & social">
      <a href="/constitution">Constitution</a>
      <a href="/complaints">Complaints Procedure</a>
      <a href={`https://instagram.com/${site.instagramHandle}`} target="_blank" rel="noopener">@{site.instagramHandle}</a>
    </nav>
  </div>

  <div class="wrap foot-fine">
    <p>© {year} Oxford University History Society. A registered student society of the University of Oxford.</p>
    <p class="foot-credit">Historical engravings of the Radcliffe Camera courtesy of the <a href="https://wellcomecollection.org/" target="_blank" rel="noopener">Wellcome Collection</a> (CC BY 4.0).</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--navy);
    color: rgba(244, 238, 222, 0.82);
    padding-block: clamp(2.75rem, 5vw, 4rem) 1.5rem;
    position: relative;
    overflow: hidden;
  }
  /* Faint historical engraving (Radcliffe Camera library interior) for depth. */
  .site-footer::before {
    content: '';
    position: absolute;
    top: 0; bottom: 0; right: 0;
    width: min(720px, 60%);
    z-index: 0;
    pointer-events: none;
    background: url('/engravings/radcliffe-interior.webp') no-repeat right center;
    background-size: cover;
    opacity: 0.09;
    -webkit-mask-image: linear-gradient(to left, #000 10%, transparent 92%);
    mask-image: linear-gradient(to left, #000 10%, transparent 92%);
  }
  .site-footer > .wrap { position: relative; z-index: 1; }
  .foot {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    align-items: start;
  }
  .foot-brand img { filter: brightness(0) invert(1); opacity: 0.92; }
  .foot-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--cream-soft);
    margin: 0.9rem 0 0.2rem;
  }
  .foot-tag { font-style: italic; color: rgba(244, 238, 222, 0.65); margin: 0; }

  .foot-nav, .foot-social { display: flex; flex-direction: column; gap: 0.7rem; padding-top: 0.4rem; }
  .site-footer a {
    color: rgba(244, 238, 222, 0.82);
    text-decoration: none;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    width: fit-content;
    transition: color 0.18s ease;
  }
  .site-footer a:hover { color: var(--gold-soft); }

  .foot-fine {
    margin-top: 2.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(244, 238, 222, 0.16);
  }
  .foot-fine p { margin: 0; font-size: 0.82rem; color: rgba(244, 238, 222, 0.55); }
  .foot-credit { margin-top: 0.4rem !important; font-size: 0.72rem !important; color: rgba(244, 238, 222, 0.4) !important; }
  .foot-credit a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 960px) {
    .foot { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .foot { grid-template-columns: 1fr; gap: 1.75rem; }
  }
</style>
