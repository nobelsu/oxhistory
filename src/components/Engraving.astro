---
import data from '../data/engravings.json';

interface Props {
  slug: keyof typeof data;
  id?: string;
}
const { slug, id } = Astro.props;
const e = (data as Record<string, { image: string; title: string; year: string; context: string; credit: string }>)[slug];
// Unique id for the reveal toggle (allows the same engraving on different pages).
const cid = `eng-${id ?? slug}`;
---

<figure class="engraving">
  <div class="eng-frame">
    <img src={e.image} alt={`Engraving of ${e.title}`} loading="lazy" />

    <input type="checkbox" id={cid} class="eng-toggle" />
    <label for={cid} class="eng-hint">
      <span class="eng-dot" aria-hidden="true">i</span>
      <span class="eng-hint-text">Historical context</span>
    </label>

    <figcaption class="eng-info">
      <p class="eng-title">{e.title}<span class="eng-year"> · {e.year}</span></p>
      <p class="eng-context">{e.context}</p>
    </figcaption>
  </div>
  <figcaption class="eng-caption">{e.title}</figcaption>
</figure>

<style>
  .engraving { margin: 0; }
  .eng-frame {
    position: relative;
    overflow: hidden;
    background: var(--paper);
    border: 1px solid var(--rule-soft);
    border-radius: 4px;
    padding: 0.6rem;
    line-height: 0;
  }
  .eng-frame img { width: 100%; height: auto; display: block; }

  /* toggle checkbox — visually hidden but focusable for keyboard users */
  .eng-toggle {
    position: absolute;
    opacity: 0;
    width: 1px; height: 1px;
    margin: 0;
    pointer-events: none;
  }

  /* the affordance pill */
  .eng-hint {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem;
    background: rgba(0, 33, 71, 0.92);
    color: #fff;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    line-height: 1;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .eng-dot {
    display: grid;
    place-items: center;
    width: 1.1rem; height: 1.1rem;
    border: 1px solid rgba(255,255,255,0.7);
    border-radius: 50%;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.8rem;
  }

  /* the context overlay */
  .eng-info {
    position: absolute;
    inset: 0.6rem;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: 1.4rem;
    background: linear-gradient(to top, rgba(0,24,50,0.96) 0%, rgba(0,24,50,0.92) 55%, rgba(0,24,50,0.7) 100%);
    color: rgba(244, 238, 222, 0.92);
    line-height: 1.5;
    opacity: 0;
    transform: translateY(8%);
    transition: opacity 0.28s ease, transform 0.28s ease;
    pointer-events: none;
  }
  .eng-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: #fff;
    margin: 0;
    line-height: 1.1;
  }
  .eng-year { font-size: 0.9rem; color: var(--gold-soft); font-style: italic; }
  .eng-context { margin: 0; font-size: 0.92rem; }

  /* reveal on hover, keyboard focus, or tap (checkbox) */
  .eng-frame:hover .eng-info,
  .eng-frame:focus-within .eng-info,
  .eng-toggle:checked ~ .eng-info {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .eng-frame:hover .eng-hint,
  .eng-frame:focus-within .eng-hint,
  .eng-toggle:checked ~ .eng-hint {
    opacity: 0;
    transform: translateY(4px);
  }

  .eng-caption {
    margin-top: 0.7rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--royal);
  }

  @media (prefers-reduced-motion: reduce) {
    .eng-info, .eng-hint { transition: opacity 0.15s ease; }
  }
</style>
